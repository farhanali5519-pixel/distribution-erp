# =====================================================================
# Farhan Sales & Distribution ERP - Environment Configuration
# =====================================================================

# Deployment Mode: 'onpremise' (Single-tenant local/desktop/server) or 'cloud' (Multi-tenant SaaS)
DEPLOYMENT_MODE=onpremise

# Database Driver: 'sqlite' (Active default) or 'postgres' (Cloud / Scalable backend)
DATABASE_DRIVER=sqlite

# SQLite Database File Path (relative to project root or absolute)
SQLITE_DATABASE_PATH=data/sales_distribution.db

# PostgreSQL Connection URL (Required when DATABASE_DRIVER=postgres)
# Example: postgresql://postgres:password@localhost:5432/farhan_erp
DATABASE_URL=
